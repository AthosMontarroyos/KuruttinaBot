# KURUTTINABOT — credenciais e serviços externos.
# Um único .env na raiz serve ao modo nativo e aos dois Composes.
# O Compose define ambiente, porta, endereço de escuta, URL pública e sincronização.
# Cada serviço recebe só as variáveis declaradas; o arquivo inteiro não entra no contêiner.
# No modo nativo, dev/site:dev selecionam development; porta padrão 3666 e sync desativado.
# Não copie nem monte este arquivo em imagens ou releases.
# No Linux, restrinja o arquivo ao proprietário que faz o deploy (0600). Conta dedicada não é necessária.
# Bot de desenvolvimento
DISCORD_BOT_TOKEN_DEVELOPMENT=
DISCORD_BOT_ID_DEVELOPMENT=
DISCORD_CLIENT_SECRET_DEVELOPMENT=
DISCORD_PUBLIC_KEY_DEVELOPMENT=

# Bot principal
DISCORD_BOT_TOKEN_PRODUCTION=
DISCORD_BOT_ID_PRODUCTION=
DISCORD_CLIENT_SECRET_PRODUCTION=
DISCORD_PUBLIC_KEY_PRODUCTION=

# Assets: obrigatório para a Home; origem HTTPS pública do bucket R2.
ASSETS_BASE_URL=

# PostgreSQL: runtime usa somente URL/CA do ambiente ativo.
# Sem query string (sslmode/options etc.). TLS remoto verifica certificado.
DATABASE_URL_DEVELOPMENT=
DATABASE_URL_PRODUCTION=
DATABASE_CA_CERT_DEVELOPMENT=
DATABASE_CA_CERT_PRODUCTION=
# Credencial administrativa de migration. Pode ficar vazia até essa operação.
# Ausência ou vazio impede só a migration; não há fallback para a URL de runtime.
# O Compose de produção entrega DATABASE_MIGRATION_URL_PRODUCTION apenas ao serviço migrate.
DATABASE_MIGRATION_URL_DEVELOPMENT=
DATABASE_MIGRATION_URL_PRODUCTION=
