# ==============================================================================
# KURUTTINABOT — CONFIGURAÇÃO LOCAL
# ==============================================================================
# Copie este arquivo para `.env` e preencha somente a cópia.
# O `.env` contém segredos, é ignorado pelo Git e nunca deve ser compartilhado.

# ==============================================================================
# 1. OBRIGATÓRIO — Execução do bot
# ==============================================================================
# APP_ENV: valores aceitos `development` | `production`
# Define qual credencial será usada no Gateway e nos deploys.
# A seleção é obrigatória e nunca faz fallback para o outro bot.
#
# O contrato atual exige os dois pares de credenciais, independentemente
# de APP_ENV. Isso permite operações cross-bot autorizadas pelo BotDev.
APP_ENV=development

# AUTO_SYNC_COMMANDS: `true` executa deploys antes do login; `false` (padrão)
# mantém o bot sem republicar comandos. String vazia ou valor inválido = erro.
AUTO_SYNC_COMMANDS=false

# Bot de desenvolvimento
DISCORD_BOT_TOKEN_DEVELOPMENT=
DISCORD_BOT_ID_DEVELOPMENT=

# Bot principal / produção
# O runtime Dev também recebe esta credencial para operações cross-bot.
# Nunca registre, exponha ou envie estes segredos.
DISCORD_BOT_TOKEN_PRODUCTION=
DISCORD_BOT_ID_PRODUCTION=

# ==============================================================================
# 2. OPCIONAL — Cloudflare Tunnel / futura origem web
# ==============================================================================
# PORT define a origem web local; não cria um servidor HTTP no bot.
PORT=3666
CLOUDFLARE_TUNNEL_TOKEN_DEVELOPMENT=
CLOUDFLARE_TUNNEL_TOKEN_PRODUCTION=

# ==============================================================================
# 3. OPCIONAL — Manutenção de assets R2
# ==============================================================================
# ASSETS_BASE_URL: URL pública do bucket (para leitura via código).
# CLOUDFLARE_ACCOUNT_ID / API_TOKEN: para upload/delete via CLI R2.
# Necessários apenas para scripts de manutenção, não para o bot em execução.
ASSETS_BASE_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ==============================================================================
# 4. RESERVADO — Futuro fluxo OAuth2
# ==============================================================================
# Não consumidos pelo bot atual. Serão usados quando existir autenticação OAuth.
# DISCORD_CLIENT_SECRET_DEVELOPMENT=
# DISCORD_CLIENT_SECRET_PRODUCTION=
