# ==============================================================================
# KURUTTINABOT — CONFIGURAÇÃO LOCAL
# ==============================================================================
# ==============================================================================
# 1. AMBIENTE GLOBAL (BOT, SITE E TUNNEL)
# ==============================================================================
# development | production
APP_ENV=development
PORT=3666
CLOUDFLARE_TUNNEL_TOKEN_DEVELOPMENT=
CLOUDFLARE_TUNNEL_TOKEN_PRODUCTION=

# ==============================================================================
# 2. BOT DE DESENVOLVIMENTO
# ==============================================================================
DISCORD_BOT_TOKEN_DEVELOPMENT=
DISCORD_BOT_ID_DEVELOPMENT=
DISCORD_CLIENT_SECRET_DEVELOPMENT=

# ==============================================================================
# 3. BOT PRINCIPAL / PRODUÇÃO
# ==============================================================================
DISCORD_BOT_TOKEN_PRODUCTION=
DISCORD_BOT_ID_PRODUCTION=
DISCORD_CLIENT_SECRET_PRODUCTION=

# ==============================================================================
# 4. DEPLOY AUTOMÁTICO DE COMANDOS
# ==============================================================================
# true | false
AUTO_SYNC_COMMANDS=true

# ==============================================================================
# 5. ASSETS CLOUDFLARE URL
# ==============================================================================
ASSETS_BASE_URL=https://pub-271b6233fa924c46b0aa8664e8587f3f.r2.dev

# ==============================================================================
# 6. CLOUDFLARE R2 (para upload/delete de assets)
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ==============================================================================
# 7. POSTGRESQL — URL somente do ambiente ativo; bot usa role kuruttina_bot
# ==============================================================================
# Sem query string (sslmode/options etc.). TLS remoto verifica certificado.
DATABASE_URL_DEVELOPMENT=
DATABASE_URL_PRODUCTION=
# Pooler validado: aws-0-sa-east-1.pooler.supabase.com:5432 (session mode).
# Usuário development: kuruttina_bot.nzpvcxdxwoyjvxqkioam
# Usuário production: kuruttina_bot.ewzbassdebmjtabxpcnh
# CA PEM oficial exigida neste pooler, entre aspas com quebras de linha ou \n.
# https://supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt
DATABASE_CA_CERT_DEVELOPMENT=
DATABASE_CA_CERT_PRODUCTION=
# Somente scripts de administração/release; nunca injetar no bot/Square.
DATABASE_MIGRATION_URL_DEVELOPMENT=
DATABASE_MIGRATION_URL_PRODUCTION=
# Opcional: somente perfil Compose local-database, sem relação com Supabase.
LOCAL_DATABASE_PASSWORD=
