# ==============================================================================
# KURUTTINA FULL-STACK ENVIRONMENT VARIABLES (ROOT)
# All apps (apps/bot and apps/website) read directly from this root file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Discord Bot & OAuth Credentials
# ------------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DEV_GUILD_ID=your_development_guild_id_here
DEFAULT_PREFIX="k!"

# Auxiliary Multi-App Emoji Bot Tokens (Comma-separated auxiliary Developer Portal app tokens for extra emoji capacity)
EMOJI_BOT_TOKENS="aux_bot_token,aux_bot_token_3"

# Dev & Creator Accounts
DEV_ACCOUNT_ID=your_dev_account_id_here
CREATOR_ACCOUNT_ID=your_creator_account_id_here

# ------------------------------------------------------------------------------
# 2. Supabase Database Credentials (Active)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-supabase-project.supabase.co:5432/postgres

# Next.js / Frontend Supabase Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 3. Hosting, Ports & NextAuth Config (Localhost: 3001)
# ------------------------------------------------------------------------------
PORT=3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your_nextauth_secret_here

# Production Domain & Tunnel
CLOUDFLARE_TUNNEL_URL=https://kuruttinabot.athosmontarroyos.com
