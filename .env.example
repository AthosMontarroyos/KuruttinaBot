# KURUTTINABOT — configuração local do produto; o n8n usa ambiente próprio.
# development | production
APP_ENV=development
# O bot atual não escuta HTTP. PORT será necessário quando o site existir.
PORT=3666

# Bot de desenvolvimento
DISCORD_BOT_TOKEN_DEVELOPMENT=
DISCORD_BOT_ID_DEVELOPMENT=

# Bot principal
DISCORD_BOT_TOKEN_PRODUCTION=
DISCORD_BOT_ID_PRODUCTION=

# Sincronização no startup: true | false; ausente equivale a false.
AUTO_SYNC_COMMANDS=false

# PostgreSQL: runtime usa somente URL/CA do ambiente ativo.
# Sem query string (sslmode/options etc.). TLS remoto verifica certificado.
DATABASE_URL_DEVELOPMENT=
DATABASE_URL_PRODUCTION=
DATABASE_CA_CERT_DEVELOPMENT=
DATABASE_CA_CERT_PRODUCTION=
# Somente no release administrativo; nunca no runtime Square do produto.
DATABASE_MIGRATION_URL_DEVELOPMENT=
DATABASE_MIGRATION_URL_PRODUCTION=
