# ==============================================================================
# KURUTTINABOT — CONFIGURAÇÃO LOCAL
# ==============================================================================
# Copie este arquivo para `.env` e preencha somente a cópia.
# O `.env` contém segredos, é ignorado pelo Git e nunca deve ser compartilhado.

# ==============================================================================
# 1. AMBIENTE GLOBAL (BOT, SITE E TUNNEL)
# ==============================================================================
# Valores aceitos: development | production
# Define qual credencial será usada no Gateway e nos deploys.
# A seleção é obrigatória e nunca faz fallback para o outro bot.
APP_ENV=development
PORT=3666
# PORT define a origem web local; não cria um servidor HTTP no bot.
# Tokens dos connectors; mantenha os valores somente no `.env` local ou nas
# variáveis protegidas da plataforma de deploy.
CLOUDFLARE_TUNNEL_TOKEN_DEVELOPMENT=
CLOUDFLARE_TUNNEL_TOKEN_PRODUCTION=

# ==============================================================================
# 2. BOT DE DESENVOLVIMENTO
# ==============================================================================
# BOT TOKEN: usado para autenticar o bot no Gateway e na API Discord.
# ID: ID público da conta do bot, usado para validar a identidade antes do login.
DISCORD_BOT_TOKEN_DEVELOPMENT=
DISCORD_BOT_ID_DEVELOPMENT=

# ==============================================================================
# 3. BOT PRINCIPAL / PRODUÇÃO
# ==============================================================================
# O runtime Dev também recebe esta credencial para operações cross-bot autorizadas.
# Nunca registre, exponha em comandos ou envie estes segredos em mensagens.
DISCORD_BOT_TOKEN_PRODUCTION=
DISCORD_BOT_ID_PRODUCTION=

# ==============================================================================
# 4. DEPLOY AUTOMÁTICO DE COMANDOS
# ==============================================================================
# Valores aceitos: true | false
# true: executa todos os deploys registrados antes de conectar ao Gateway.
# false: inicia o bot sem publicar novamente os comandos. Padrão seguro.
AUTO_SYNC_COMMANDS=false
