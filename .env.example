# Nomes usados pelo projeto. Valores reais ficam no Doppler, configs dev e prd,
# com os mesmos nomes e o segredo daquele ambiente. Não coloque segredo aqui.
# Copie para .env só na máquina local. .env não entra no Git.

# development ou production. npm run bot dev e npm run site dev fixam development.
APP_ENV=

# PostgreSQL server-side. DATABASE_URL é a role kuruttina_bot.
# SITE_DATABASE_URL é a role kuruttina_site. DATABASE_MIGRATION_URL só em migrate/seed.
DATABASE_URL=
SITE_DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_CA=

# Identificadores do projeto Supabase deste config. O processo não lê estes nomes.
# A conexão vai nas URLs acima. Servem para estes dados não voltarem ao repositório.
SUPABASE_PROJECT_REF=
DATABASE_POOLER_HOST=

# Cadastro inicial de npm run database:seed. Snowflakes distintos deste ambiente.
# O seed falha se algum nome faltar ou não for um snowflake válido.
SEED_GUILD_ID=
SEED_CREATOR_ID=
SEED_DEV_ID=

# Discord. DISCORD_CLIENT_SECRET é só do site (OAuth). O bot não recebe esse nome.
DISCORD_BOT_TOKEN=
DISCORD_BOT_ID=
DISCORD_CLIENT_SECRET=

# Site. ASSETS_BASE_URL é a origem HTTPS pública dos assets.
# HOST, PORT e SITE_URL são fixos no Compose; no nativo, PORT padrão 3666.
ASSETS_BASE_URL=
SITE_URL=
HOST=
PORT=
SESSION_FILE=

# Opcional. Só no config Doppler dev. PAT para /dev emoji add disparar emoji-prod.yml.
GITHUB_WORKFLOW_TOKEN=
