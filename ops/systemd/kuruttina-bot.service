# Processo Discord do KuruttinaBot.
# Instalação e build ocorrem no release, antes desta unidade subir.
# Segredos ficam em /etc/kuruttina/bot.env, não nesta unidade.

[Unit]
Description=KuruttinaBot Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kuruttina
Group=kuruttina
WorkingDirectory=/opt/kuruttina/current
EnvironmentFile=/etc/kuruttina/bot.env
ExecStart=/usr/bin/node dist/apps/bot/src/index.js
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=120
StartLimitBurst=5
TimeoutStopSec=15s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kuruttina-bot
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
