{
  "name": "kuruttina-bot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/config",
    "packages/database",
    "packages/message-templates"
  ],
  "imports": {
    "#bot/*": "./dist/apps/bot/src/*"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "site:build": "node apps/site/build.mjs",
    "site:start": "node dist/apps/site/index.js",
    "site:dev": "npm run site:build && node --import @kuruttina/config/development dist/apps/site/index.js",
    "build": "node -e \"require('node:fs').rmSync('dist/apps/bot',{recursive:true,force:true})\" && tsc -p apps/bot/tsconfig.build.json",
    "build:all": "npm run build && npm run site:build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/site/tsconfig.json",
    "start": "node dist/apps/bot/src/index.js",
    "deploy:commands": "node dist/apps/bot/src/deployments/deploy-central.js",
    "dev": "node --import @kuruttina/config/development --import tsx apps/bot/src/index.ts",
    "security:secrets": "gitleaks detect --source . --config .gitleaks.toml --redact --verbose",
    "test": "vitest run --exclude tests/database.integration.test.ts",
    "database:migrate": "node packages/database/cli.js migrate",
    "database:seed": "node packages/database/cli.js seed",
    "test:database": "vitest run tests/database.integration.test.ts"
  },
  "dependencies": {
    "@kuruttina/config": "*",
    "@kuruttina/database": "*",
    "@kuruttina/message-templates": "*",
    "@types/node": "22.13.10",
    "@types/pg": "8.23.1",
    "discord.js": "14.27.0",
    "dotenv": "16.4.7",
    "gifenc": "1.0.3",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "typescript": "5.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.3",
    "vite": "8.3.4",
    "vitest": "5.0.0"
  }
}
