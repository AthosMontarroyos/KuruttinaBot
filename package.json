{
  "name": "kuruttina-bot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/config",
    "packages/database"
  ],
  "imports": {
    "#bot/*": "./dist/apps/bot/src/*"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p apps/bot/tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/apps/bot/src/index.js",
    "deploy:commands": "node dist/apps/bot/src/deployments/deploy-central.js",
    "dev": "tsx apps/bot/src/index.ts",
    "security:secrets": "gitleaks detect --source . --config .gitleaks.toml --redact --verbose",
    "test": "vitest run",
    "database:migrate": "node packages/database/cli.js migrate",
    "database:seed": "node packages/database/cli.js seed",
    "test:database": "bash tests/support/test-postgres.sh"
  },
  "dependencies": {
    "@kuruttina/config": "*",
    "@kuruttina/database": "*",
    "@types/node": "22.13.10",
    "@types/pg": "8.23.1",
    "discord.js": "14.27.0",
    "dotenv": "16.4.7",
    "gifenc": "1.0.3",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "typescript": "5.8.2"
  },
  "devDependencies": {
    "tsx": "4.19.3",
    "vitest": "5.0.0"
  }
}
