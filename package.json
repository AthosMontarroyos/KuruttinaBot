{
  "name": "kuruttina-bot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/config",
    "packages/database"
  ],
  "imports": {
    "#bot/*": "./dist/apps/bot/src/*"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "tunnel": "node scripts/cloudflare/tunnel.mjs",
    "tunnel:development": "node scripts/cloudflare/tunnel.mjs development",
    "tunnel:production": "node scripts/cloudflare/tunnel.mjs production",
    "tunnel:check": "node scripts/cloudflare/tunnel.mjs --check",
    "build": "npm run build:bot",
    "prebuild:bot": "node scripts/build/clean-dist.mjs",
    "build:bot": "node --no-warnings --experimental-strip-types scripts/build/build-bot.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run start:bot",
    "start:bot": "node dist/apps/bot/src/index.js",
    "start:development": "npm run start:bot:development",
    "start:production": "npm run start:bot:production",
    "start:bot:development": "node dist/apps/bot/src/runner.js development",
    "start:bot:production": "node dist/apps/bot/src/runner.js production",
    "deploy:commands": "node dist/apps/bot/src/deployments/deploy-central.js",
    "deploy:central": "node dist/apps/bot/src/deployments/deploy-central.js",
    "dev": "npm run dev:bot",
    "dev:bot": "tsx apps/bot/src/index.ts",
    "dev:development": "npm run dev:bot:development",
    "dev:production": "npm run dev:bot:production",
    "dev:bot:development": "tsx apps/bot/src/runner.ts development",
    "dev:bot:production": "tsx apps/bot/src/runner.ts production",
    "r2:mount": "bash scripts/r2/mount-r2-pictures.sh",
    "r2:unmount": "bash scripts/r2/unmount-r2-pictures.sh",
    "security:secrets": "gitleaks detect --source . --config .gitleaks.toml --redact --verbose",
    "security:secrets:docker": "docker run --rm -v \"${PWD}:/repo\" zricethezav/gitleaks:v8.30.1 git /repo --config /repo/.gitleaks.toml --redact --no-banner",
    "test": "vitest run",
    "emoji:r2:sync": "tsx scripts/discord/sync-discord-emojis.ts r2",
    "emoji:sync": "tsx scripts/discord/sync-discord-emojis.ts all",
    "r2": "node scripts/r2/r2-cloud.mjs",
    "r2:list": "node scripts/r2/r2-cloud.mjs list",
    "r2:info": "node scripts/r2/r2-cloud.mjs info",
    "r2:upload": "node scripts/r2/r2-cloud.mjs upload",
    "r2:delete": "node scripts/r2/r2-cloud.mjs delete",
    "r2:size": "node scripts/r2/r2-cloud.mjs size",
    "database:migrate": "node scripts/database/admin.mjs migrate",
    "database:seed": "node scripts/database/admin.mjs seed",
    "test:database": "bash scripts/database/test-postgres.sh"
  },
  "dependencies": {
    "@kuruttina/config": "*",
    "@kuruttina/database": "*",
    "@types/node": "22.13.10",
    "@types/pg": "8.23.1",
    "discord.js": "14.27.0",
    "dotenv": "16.4.7",
    "pg": "8.23.0",
    "typescript": "5.8.2"
  },
  "devDependencies": {
    "tsx": "4.19.3",
    "vitest": "5.0.0"
  }
}
