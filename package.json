{
  "name": "kuruttina-bot",
  "private": true,
  "type": "module",
  "workspaces": ["packages/config"],
  "imports": {
    "#bot/*": "./dist/apps/bot/src/*"
  },
  "engines": { "node": "22.14.x" },
  "scripts": {
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:development": "node scripts/tunnel.mjs development",
    "tunnel:production": "node scripts/tunnel.mjs production",
    "tunnel:check": "node scripts/tunnel.mjs --check",
    "build": "npm run build:bot",
    "prebuild:bot": "node scripts/clean-dist.mjs",
    "build:bot": "tsc -p apps/bot/tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run start:bot",
    "start:bot": "node dist/apps/bot/src/index.js",
    "start:development": "npm run start:bot:development",
    "start:production": "npm run start:bot:production",
    "start:bot:development": "node dist/apps/bot/src/runner.js development",
    "start:bot:production": "node dist/apps/bot/src/runner.js production",
    "deploy:commands": "node dist/apps/bot/src/deployments/deploy-central.js",
    "deploy:central": "node dist/apps/bot/src/deployments/deploy-central.js",
    "dev": "npm run dev:bot",
    "dev:bot": "tsx apps/bot/src/index.ts",
    "dev:development": "npm run dev:bot:development",
    "dev:production": "npm run dev:bot:production",
    "dev:bot:development": "tsx apps/bot/src/runner.ts development",
    "dev:bot:production": "tsx apps/bot/src/runner.ts production",
    "assets:mount": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mount-r2-pictures.ps1",
    "assets:unmount": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unmount-r2-pictures.ps1",
    "security:secrets": "gitleaks detect --source . --config .gitleaks.toml --redact --verbose",
    "security:secrets:docker": "docker run --rm -v \"%cd%:/repo\" zricethezav/gitleaks:v8.30.1 git /repo --config /repo/.gitleaks.toml --redact --no-banner",
    "test": "vitest run"
  },
  "dependencies": {
    "@kuruttina/config": "*",
    "@types/node": "22.13.10",
    "discord.js": "14.27.0",
    "dotenv": "16.4.7",
    "typescript": "5.8.2"
  },
  "devDependencies": {
    "tsx": "4.19.3",
    "vitest": "5.0.0"
  }
}
