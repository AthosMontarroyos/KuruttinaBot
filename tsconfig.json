{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist", "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "esModuleInterop": true, "skipLibCheck": true,
    "allowJs": true, "checkJs": true, "rewriteRelativeImportExtensions": true,
    "paths": {
      "#bot/*": ["./apps/bot/src/*"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.js", "scripts/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
